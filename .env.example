# Copy to .env and fill in LOCALLY. Never commit .env. Never paste these values into Claude.
# SQLAlchemy needs the driver prefix postgresql+psycopg:// (Supabase shows postgresql://; change the prefix).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME      # Supabase POOLED string
DIRECT_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME        # same as database url
JWT_SECRET=change-me-to-32-plus-random-bytes
GROQ_API_KEY=
# Model names change: check the Groq console on build day
GROQ_CLASSIFY_MODEL=openai/gpt-oss-120b
GROQ_CLASSIFY_FALLBACKS=openai/gpt-oss-20b,qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3
AI_MODE=mock                 # mock | live (live needs GROQ_API_KEY)
DEMO_TODAY=2026-11-03        # keeps the seeded colours stable (A-13)
DEMO_LOGINS_VISIBLE=true
APP_URL=http://localhost:5173
ENV=dev                      # dev | prod
# Frontend only
VITE_USE_FIXTURES=false
VITE_API_BASE=/api
VITE_DEMO_LOGINS=true         # show demo logins on the sign-in screen (build-time flag; set false for a real rollout)
