{
  "name": "nool-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:types": "openapi-typescript ../contract/openapi.json -o src/api/types.gen.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/inter": "^5.0.0",
    "@fontsource/noto-sans-tamil": "^5.0.0",
    "dexie": "3.2.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.0.0",
    "openapi-typescript": "^7.4.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "terser": "^5.51.2",
    "typescript": "^5.5.0",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.1.0"
  }
}
